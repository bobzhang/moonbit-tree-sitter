options(
  "pre-build": [
    {
      "command": "moonx moonbitlang/ulex $input | moonfmt > $output",
      "input": "lexer.mbtx",
      "output": "lexer.mbt",
    },
    {
      "command": "moonx moonbitlang/yacc $input --external-tokens | moonfmt > $output",
      "input": "parser.mbty",
      "output": "parser.mbt",
    },
  ],
)

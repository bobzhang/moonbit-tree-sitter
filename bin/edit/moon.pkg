import {
  "moonbitlang/x/sys",
  "moonbitlang/x/fs",
  "tonyfettes/tree_sitter",
  "tonyfettes/tree_sitter_moonbit",
  "tonyfettes/tree_sitter_yaml",
  "moonbitlang/x/encoding",
  "tonyfettes/tree_sitter/sexp",
  "yj-qin/regexp",
  "tonyfettes/tree_sitter_query",
}

pkgtype(kind: "executable")

warnings = "-15+15"

options(
  link: { "native": { "cc": "clang", "cc-flags": "-g -fsanitize=address" } },
)
